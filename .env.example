# Google Cloud
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# Vertex AI model (gemini-2.0-flash-001 or gemini-1.5-pro-002)
GEMINI_MODEL="gemini-2.0-flash-001"

# Postgres — game_stories database
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="your-db-user"
DB_PASSWORD=""
DB_NAME="game_stories"

# LangSmith tracing (optional but strongly recommended)
LANGCHAIN_API_KEY="your-langsmith-key"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="story-agent-phase1"
